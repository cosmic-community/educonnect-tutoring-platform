---
import type { Subject } from '../types';

export interface Props {
  subject: Subject;
}

const { subject } = Astro.props;
---

<div class="bg-white rounded-xl shadow-sm border border-secondary-200 hover:shadow-md transition-all duration-300 overflow-hidden">
  <!-- Subject Icon -->
  {subject.metadata?.subject_icon && (
    <div class="h-32 bg-gradient-to-br from-primary-50 to-primary-100 flex items-center justify-center">
      <img 
        src={`${subject.metadata.subject_icon.imgix_url}?w=100&h=100&fit=crop&auto=format,compress`}
        alt={subject.metadata?.subject_name || subject.title}
        class="w-16 h-16 object-cover rounded-lg"
        width="64"
        height="64"
      />
    </div>
  )}

  <div class="p-6">
    <!-- Subject Name -->
    <h3 class="text-lg font-semibold text-secondary-900 mb-2">
      {subject.metadata?.subject_name || subject.title}
    </h3>

    <!-- Description -->
    {subject.metadata?.description && (
      <p class="text-secondary-600 text-sm mb-4 line-clamp-3">
        {subject.metadata.description}
      </p>
    )}

    <!-- Difficulty Level and Duration -->
    <div class="flex justify-between items-center mb-4">
      {subject.metadata?.difficulty_level && (
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
          subject.metadata.difficulty_level.key === 'beginner'
            ? 'bg-green-100 text-green-800'
            : subject.metadata.difficulty_level.key === 'intermediate'
            ? 'bg-yellow-100 text-yellow-800'
            : subject.metadata.difficulty_level.key === 'advanced'
            ? 'bg-red-100 text-red-800'
            : 'bg-blue-100 text-blue-800'
        }`}>
          {subject.metadata.difficulty_level.value}
        </span>
      )}
      {subject.metadata?.session_duration && (
        <span class="text-sm text-secondary-500">
          {subject.metadata.session_duration}hr sessions
        </span>
      )}
    </div>

    <!-- Popular Badge -->
    {subject.metadata?.is_popular && (
      <div class="mb-4">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
          ⭐ Popular Choice
        </span>
      </div>
    )}

    <!-- Fee Structure Preview -->
    {subject.metadata?.fee_structure && (
      <div class="mb-4 p-3 bg-secondary-50 rounded-lg">
        <h4 class="text-sm font-medium text-secondary-900 mb-2">Pricing:</h4>
        <div class="text-xs text-secondary-600" set:html={subject.metadata.fee_structure.substring(0, 150) + '...'}>
        </div>
      </div>
    )}

    <!-- Learn More Button -->
    <a 
      href={`/subjects/${subject.slug}`}
      class="w-full bg-primary-600 hover:bg-primary-700 text-white text-center py-2 px-4 rounded-lg text-sm font-medium transition-colors inline-block"
    >
      Learn More
    </a>
  </div>
</div>