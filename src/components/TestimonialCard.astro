---
import type { Testimonial } from '../types';

export interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;

const renderStars = (rating: number) => {
  return Array.from({ length: 5 }, (_, index) => {
    const filled = index < rating ? 'text-yellow-400' : 'text-secondary-300';
    return { filled, index };
  });
};

// Extract rating number from the rating object
const ratingNumber = testimonial.metadata?.rating ? parseInt(testimonial.metadata.rating.key) : 5;
---

<div class="bg-white rounded-xl shadow-sm border border-secondary-200 p-6">
  <!-- Rating Stars -->
  <div class="flex text-yellow-400 mb-4">
    {renderStars(ratingNumber).map(({ filled, index }) => (
      <svg
        class={`w-5 h-5 ${filled}`}
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          fill-rule="evenodd"
          d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"
          clip-rule="evenodd"
        />
      </svg>
    ))}
  </div>

  <!-- Testimonial Text -->
  {testimonial.metadata?.testimonial_text && (
    <blockquote class="text-secondary-700 mb-6 italic">
      "{testimonial.metadata.testimonial_text}"
    </blockquote>
  )}

  <!-- Student Info -->
  <div class="flex items-center">
    {testimonial.metadata?.student_photo && (
      <img 
        src={`${testimonial.metadata.student_photo.imgix_url}?w=80&h=80&fit=crop&auto=format,compress`}
        alt={testimonial.metadata?.student_name || 'Student'}
        class="w-12 h-12 rounded-full object-cover mr-4"
        width="48"
        height="48"
      />
    )}
    <div class="flex-1">
      {testimonial.metadata?.student_name && (
        <h4 class="font-medium text-secondary-900">
          {testimonial.metadata.student_name}
        </h4>
      )}
      {testimonial.metadata?.subject_studied && (
        <p class="text-sm text-secondary-600">
          {testimonial.metadata.subject_studied.metadata?.subject_name || testimonial.metadata.subject_studied.title}
        </p>
      )}
      {testimonial.metadata?.achievement && (
        <p class="text-sm text-green-600 font-medium mt-1">
          {testimonial.metadata.achievement}
        </p>
      )}
    </div>
  </div>

  <!-- Tutor Info -->
  {testimonial.metadata?.tutor && (
    <div class="mt-4 pt-4 border-t border-secondary-100">
      <p class="text-sm text-secondary-600">
        Tutor: <span class="font-medium text-secondary-900">
          {testimonial.metadata.tutor.metadata?.full_name || testimonial.metadata.tutor.title}
        </span>
      </p>
    </div>
  )}

  <!-- Featured Badge -->
  {testimonial.metadata?.is_featured && (
    <div class="mt-4">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
        ⭐ Featured Review
      </span>
    </div>
  )}
</div>